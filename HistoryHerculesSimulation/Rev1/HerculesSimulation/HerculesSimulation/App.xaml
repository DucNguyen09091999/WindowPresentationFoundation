<Application x:Class="HerculesSimulation.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:HerculesSimulation"
             xmlns:views="clr-namespace:HerculesSimulation.Views"
             xmlns:viewmodels="clr-namespace:HerculesSimulation.ViewModels"
             StartupUri="Views/MainWindow.xaml">
    <Application.Resources>
        <DataTemplate DataType="{x:Type viewmodels:UdpSetupViewModel}">
            <views:UdpSetupView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:SerialViewModel}">
            <views:SerialView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:TcpClientViewModel}">
            <views:TcpClientView/>
        </DataTemplate>
    </Application.Resources>
</Application>
