<UserControl x:Class="HerculesSimulation.Views.SerialView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:HerculesSimulation.Views"
             xmlns:models="clr-namespace:HerculesSimulation.Models"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="640">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="0,0,10,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Received/Sent data"/>

            <Border Grid.Row="1" BorderBrush="Gray"  BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                  Background="White">

                    <ItemsControl ItemsSource="{Binding LogEntries}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:LogEntry}">
                                <TextBlock Margin="2,0,2,0"
                               FontFamily="Consolas"
                               TextWrapping="Wrap">
                        
                        <Run Text="{Binding Timestamp, Mode=OneWay}" 
                             Foreground="Gray"/>
                        
                        <Run Text="{Binding Text, Mode=OneWay}" 
                             Foreground="{Binding Color}"/>

                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
            <GroupBox Grid.Row="2" Header="Modem lines" Margin="0,5,0,0">
                <StackPanel Orientation="Horizontal" Margin="5" HorizontalAlignment="Right">
                    <CheckBox Content="CD" IsChecked="{Binding IsCdActive}" 
                              Style="{StaticResource LedCheckBoxStyle}" IsHitTestVisible="False"/>
                    <CheckBox Content="RI" IsChecked="{Binding IsRiActive}" 
                              Style="{StaticResource LedCheckBoxStyle}" IsHitTestVisible="False"/>
                    <CheckBox Content="DSR" IsChecked="{Binding IsDsrActive}" 
                              Style="{StaticResource LedCheckBoxStyle}" IsHitTestVisible="False"/>
                    <CheckBox Content="CTS" IsChecked="{Binding IsCtsActive}" 
                              Style="{StaticResource LedCheckBoxStyle}" IsHitTestVisible="False"/>

                    <CheckBox Content="DTR" IsChecked="{Binding IsDtrEnabled}" 
                              Style="{StaticResource LedCheckBoxStyle}"/>
                    <CheckBox Content="RTS" IsChecked="{Binding IsRtsEnabled}" 
                              Style="{StaticResource LedCheckBoxStyle}"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Grid.Row="3" Header="Send" Margin="0,5,0,0">
                <StackPanel>
                    <Grid Margin="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding SendText1}" FontFamily="Consolas"/>
                        <CheckBox Grid.Column="1" Content="HEX" IsChecked="{Binding IsHex1}" 
                                  VerticalAlignment="Center" Margin="5,0"/>
                        <Button Grid.Column="2" Content="Send" Command="{Binding Send1Command}" 
                                Padding="10,2"/>
                    </Grid>
                    <Grid Margin="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding SendText2}" FontFamily="Consolas"/>
                        <CheckBox Grid.Column="1" Content="HEX" IsChecked="{Binding IsHex2}" 
                                  VerticalAlignment="Center" Margin="5,0"/>
                        <Button Grid.Column="2" Content="Send" Command="{Binding Send2Command}" 
                                Padding="10,2"/>
                    </Grid>
                    <Grid Margin="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding SendText3}" FontFamily="Consolas"/>
                        <CheckBox Grid.Column="1" Content="HEX" IsChecked="{Binding IsHex3}" 
                                  VerticalAlignment="Center" Margin="5,0"/>
                        <Button Grid.Column="2" Content="Send" Command="{Binding Send3Command}" 
                                Padding="10,2"/>
                    </Grid>
                </StackPanel>
            </GroupBox>
        </Grid>

        <Grid Grid.Column="1" Width="150">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <GroupBox Grid.Row="0" Header="Serial" FontWeight="Bold">
                <Grid Margin="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Name" Style="{StaticResource LabelStyle}"/>
                    <ComboBox Grid.Row="1"  
                              ItemsSource="{Binding PortNames}"
                              SelectedItem="{Binding SelectedPortName}"/>

                    <TextBlock Grid.Row="2" Text="Baud" Style="{StaticResource LabelStyle}"/>
                    <ComboBox Grid.Row="3"
                              ItemsSource="{Binding BaudRates}"
                              SelectedItem="{Binding SelectedBaudRate}"/>

                    <TextBlock Grid.Row="4" Text="Data size" Style="{StaticResource LabelStyle}"/>
                    <ComboBox Grid.Row="5"  
                              ItemsSource="{Binding DataSizes}"
                              SelectedItem="{Binding SelectedDataSize}"/>

                    <TextBlock Grid.Row="6" Text="Parity" Style="{StaticResource LabelStyle}"/>
                    <ComboBox Grid.Row="7"
                              ItemsSource="{Binding Parities}"
                              SelectedItem="{Binding SelectedParity}"/>

                    <TextBlock Grid.Row="8" Text="Handshake" Style="{StaticResource LabelStyle}"/>
                    <ComboBox Grid.Row="9" 
                              ItemsSource="{Binding Handshakes}"
                              SelectedItem="{Binding SelectedHandshake}"/>

                    <TextBlock Grid.Row="10" Text="Mode" Style="{StaticResource LabelStyle}"/>
                    <ComboBox Grid.Row="11"
                              ItemsSource="{Binding Modes}"
                              SelectedItem="{Binding SelectedMode}"/>
                    
                    <Button Margin="0 30 0 0" Grid.Row="12" Command="{Binding OpenPortCommand}" 
                        Style="{StaticResource IconButtonStyle}" 
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="../Resources/Assets/Icons/Hercules-SETUP.gif" Style="{StaticResource IconStyle}"/>
                            <TextBlock Text="{Binding OpenButtonText}" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>

                    <Button Grid.Row="13" Command="{Binding HwgFwUpdateCommand}" 
                        Style="{StaticResource IconButtonStyle}" 
                        HorizontalAlignment="Stretch" Margin="0,5,0,0" HorizontalContentAlignment="Center">
                        <TextBlock Text="HWg FW update"/>
                    </Button>
                </Grid>
            </GroupBox>

            <StackPanel Grid.Row="2" HorizontalAlignment="Center">
                <Image Source="../Resources/Assets/Icons/Hercules-SETUP.gif" Height="50" Margin="0,15,0,0"/>
                <TextBlock Text="Hercules SETUP utility" HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding Version}" HorizontalAlignment="Center" FontWeight="Bold"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
