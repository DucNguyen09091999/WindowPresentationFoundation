<UserControl x:Class="HerculesSimulation.Views.UdpSetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:HerculesSimulation.Views"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="640">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="{Binding DevicesFoundText}" 
                       Margin="5 0 0 0"/>

            <ListView Grid.Row="1" Margin="5"
                      ItemsSource="{Binding Devices}"
                      SelectedItem="{Binding SelectedDevice}"
                      BorderBrush="Gray" BorderThickness="1"/>

            <StackPanel Grid.Row="2" Margin="5,10,5,5">
                <Button Command="{Binding TcpSetupConfigCommand}" 
                        Style="{StaticResource IconButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="../Resources/Assets/Icons/Hercules-SETUP.gif" Style="{StaticResource IconStyle}"/>
                        <TextBlock Text="TCP Setup configuration"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding ConnectTcpClientCommand}" Margin="0,5,0,0"
                        Style="{StaticResource IconButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="../Resources/Assets/Icons/Hercules-SETUP.gif" Style="{StaticResource IconStyle}"/>
                        <TextBlock Text="Connect with TCP Client"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding OpenInWebCommand}" Margin="0,5,0,0"
                        Style="{StaticResource IconButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="../Resources/Assets/Icons/Hercules-SETUP.gif" Style="{StaticResource IconStyle}"/>
                        <TextBlock Text="Open in the WEB Browser"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Column="1" Margin="10,0,0,0" Width="160">

            <GroupBox Header="Required parameters" BorderBrush="LightGray">
                <Grid Margin="5 5 5 5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Module name:" Style="{StaticResource LabelStyle}"/>
                    <TextBox Grid.Row="1" Text="{Binding ModuleName}"/>

                    <TextBlock Grid.Row="2" Text="Module IP" Style="{StaticResource LabelStyle}"/>
                    <TextBox Grid.Row="3" Text="{Binding ModuleIP}"/>

                    <TextBlock Grid.Row="4" Text="Port" Style="{StaticResource LabelStyle}"/>
                    <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding Port}" Width="50" HorizontalAlignment="Left"/>

                    <TextBlock Grid.Row="6" Text="Module IP mask" Style="{StaticResource LabelStyle}"/>
                    <TextBox Grid.Row="7" Text="{Binding ModuleIPMask}"/>

                    <TextBlock Grid.Row="8" Text="Gateway:" Style="{StaticResource LabelStyle}"/>
                    <TextBox Grid.Row="9" Text="{Binding Gateway}"/>
                </Grid>
            </GroupBox>

            <GroupBox Header="Settings" Margin="0,5,0,0">
                <StackPanel Margin="5">
                    <CheckBox Content="TCP TEA authorization" IsChecked="{Binding IsTcpTeaEnabled}"/>
                    <CheckBox Content="Enable NVT" IsChecked="{Binding IsNvtEnabled}" Margin="0,5,0,0"/>
                    <CheckBox Content="Enable TCP setup" IsChecked="{Binding IsTcpSetupEnabled}" Margin="0,5,0,0"/>
                    <CheckBox Content="Enable DHCP" IsChecked="{Binding IsDhcpEnabled}" Margin="0,5,0,0"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Your PC network settings" Margin="0,5,0,0">
                <Grid Margin="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="IP:" Style="{StaticResource LabelStyle}"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding NetworkSettingsVM.PcIP}"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="MASK:" Style="{StaticResource LabelStyle}"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding NetworkSettingsVM.PcMask}"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="GW:" Style="{StaticResource LabelStyle}"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding NetworkSettingsVM.PcGateway}"/>
                </Grid>
            </GroupBox>
        </StackPanel>

        <StackPanel Grid.Column="2" Margin="10,0,0,0" Width="150">

            <Button Command="{Binding FindDevicesCommand}" 
                    Style="{StaticResource IconButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Image Source="../Resources/Assets/Icons/Hercules-SETUP.gif" Style="{StaticResource IconStyle}"/>
                    <TextBlock Text="Find devices" FontWeight="Bold"/>
                </StackPanel>
            </Button>
            <Button Command="{Binding ApplyChangesCommand}" Margin="0,5,0,0"
                    Style="{StaticResource IconButtonStyle}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Image Source="../Resources/Assets/Icons/Hercules-SETUP.gif" Style="{StaticResource IconStyle}"/>
                    <TextBlock Text="Apply changes"/>
                </StackPanel>
            </Button>
            <Button Command="{Binding RestoreDefaultsCommand}" Margin="0,5,0,0"
                    Style="{StaticResource IconButtonStyle}" HorizontalContentAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Image Source="../Resources/Assets/Icons/Hercules-SETUP.gif" Style="{StaticResource IconStyle}"/>
                    <TextBlock Text="Restore default values"/>
                </StackPanel>
            </Button>

            <StackPanel Margin="5 10 5 5">
                <TextBlock Text="Device Type:"/>
                <TextBlock Text="{Binding DeviceType}"/>
                <TextBlock Text="FW version:" Margin="0 10 0 0"/>
                <TextBlock Text="{Binding FirmwareVersion}"/>
            </StackPanel>

            <GroupBox Header="IP Filter" Margin="0,10,0,0">
                <StackPanel Margin="5">
                    <TextBlock Text="IP Filter Address Range"/>
                    <TextBox Text="{Binding IpFilterRange}" Margin="0,2,0,0"/>
                    <TextBlock Text="IP Filter MASK" Margin="0,5,0,0"/>
                    <TextBox Text="{Binding IpFilterMask}" Margin="0,2,0,0"/>
                </StackPanel>
            </GroupBox>

            <Image Source="../Resources/Assets/Icons/Hercules-SETUP.gif" Height="50" Margin="0,15,0,0"/>
            <TextBlock Text="Hercules SETUP utility" HorizontalAlignment="Center"/>
            <TextBlock Text="{Binding Version}" HorizontalAlignment="Center" FontWeight="Bold"/>
        </StackPanel>
    </Grid>
</UserControl>
